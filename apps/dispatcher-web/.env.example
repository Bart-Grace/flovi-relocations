# Copy to .env.local for local dev. Both values are safe to expose: the publishable key
# ships in the browser bundle by design, and RLS against auth.uid() is the real boundary.
#
# NEVER put sb_secret_/service_role here — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
